{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,pull_requests,actions"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "netlify": {
      "type": "http",
      "url": "https://netlify-mcp.netlify.app/mcp"
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:render-api-key}"
      }
    }
  },
  "inputs": [
    {
      "id": "render-api-key",
      "type": "promptString",
      "description": "Render API key for the intended workspace",
      "password": true
    }
  ]
}